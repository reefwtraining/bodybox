rules_version = '2';
// BODYBOX app (Firebase project teambodybox-app).
// Paste into Firebase console > Firestore > Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isCoach() {
      return signedIn()
        && request.auth.token.email in ['reefwtraining@gmail.com', 'reefwtraining+bodybox@gmail.com']
        && request.auth.token.email_verified == true;
    }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function approved() {
      return signedIn()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.approved == true;
    }
    // Admin (Jameson, Nov 17): members/{uid}.admin == true, set only by a coach.
    // Runs members, payments, events, challenges and athlete messages. No programming, Board or app changes.
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('approved', false) == true
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('admin', false) == true;
    }
    function staff() { return isCoach() || isAdmin(); }

    // One doc per person who signs up. Only a coach can approve or turn programs on.
    // Members may only set their name and their picks/codes.
    match /members/{uid} {
      allow read: if staff() || isMe(uid);
      allow create: if isMe(uid)
        && request.resource.data.approved == false
        && request.resource.data.keys().hasOnly(['name', 'email', 'approved', 'created']);
      allow update: if isCoach()
        || (isMe(uid) && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'wants', 'codes', 'codeProgs', 'wantsAt', 'repick', 'socials', 'about', 'photo']))
        // Admin: approve, pause, programs on/off. Not coaches, not other admins, can't turn Personal on.
        || (isAdmin() && resource.data.get('admin', false) != true
            && !('staff' in resource.data.get('wants', []))
            && resource.data.get('staffProgs', []).size() == 0
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved', 'approvedAt', 'progs'])
            && (!('personal' in request.resource.data.get('progs', [])) || ('personal' in resource.data.get('progs', []))));
      allow delete: if isCoach();
    }

    // Programming and leaderboard. Approved members read, coaches write.
    match /content/{docId} {
      allow read: if isCoach() || approved();
      allow write: if isCoach();
    }

    // People list for challenges (name only). Each person writes their own entry.
    match /people/{uid} {
      allow read: if isCoach() || approved();
      allow write: if isMe(uid) && (isCoach() || approved())
        && request.resource.data.keys().hasOnly(['name', 'a', 'at']);
    }

    // Head-to-head challenges. Only the two people in it can change it.
    match /challenges/{id} {
      allow read: if staff() || (signedIn() && request.auth.uid in resource.data.parts);
      allow create: if ((isCoach() || approved())
        && request.resource.data.from.uid == request.auth.uid
        && request.auth.uid in request.resource.data.parts
        && request.resource.data.parts.size() == 2)
        || (isAdmin() && request.resource.data.parts.size() == 2 && request.resource.data.setBy.uid == request.auth.uid);
      allow update: if staff() || (signedIn() && request.auth.uid in resource.data.parts
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'scores', 'doneAt', 'at']));
      allow delete: if staff() || (signedIn() && resource.data.from.uid == request.auth.uid);
    }

    // Good job taps. Everyone sees them; you can only add or remove your own.
    match /cheers/{id} {
      allow read: if isCoach() || approved();
      allow create: if (isCoach() || approved()) && request.resource.data.uid == request.auth.uid
        && id.matches('.*__' + request.auth.uid);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Team chat. Everyone approved reads and posts; you can delete your own, coaches any.
    match /chat/{id} {
      allow read: if isCoach() || approved();
      allow create: if (isCoach() || approved())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'badge', 'text', 'at'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 600;
      allow delete: if staff() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // One-on-one with the coaches. Only that athlete, Coach Reef and the admin.
    match /dms/{uid}/msgs/{id} {
      allow read: if staff() || (isMe(uid) && approved());
      allow create: if (staff() || (isMe(uid) && approved()))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'badge', 'text', 'at'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 600;
      allow delete: if staff() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    match /{path=**}/msgs/{id} {
      allow read: if staff();
    }

    // Phone alerts: each person saves their own subscription; only coaches read them (to send).
    match /pushSubs/{uid} {
      allow read: if isCoach();
      allow write: if isMe(uid);
    }

    // Each person's own logs, scores, profile. Coaches (Reef + Claude's coach login) can read and enter data for anyone.
    match /data/users/{uid}/{docId} {
      allow read, write: if isMe(uid) && (approved() || isCoach());
      allow read, write: if isCoach();
      // Admin reads logs and check-ins (never the coach config with the timer PINs) and can start a new athlete's file on approval.
      allow read: if isAdmin() && uid != 'coachcfg';
      allow create: if isAdmin() && uid != 'coachcfg' && !uid.matches('pre_.*');
    }

    // Payments: one doc per member (rate, paid through, note) + billing/_prices. Coach and admin; each athlete reads their own.
    match /billing/{id} {
      allow read: if staff() || isMe(id);
      allow write: if staff();
    }

    // Price flyers uploaded from the admin page (picture + optional PDF). Public read so share links work; coach and admin write.
    match /flyers/{id} {
      allow read: if true;
      allow write: if staff();
    }
    match /flyerpdfs/{id} {
      allow read: if true;
      allow write: if staff();
    }

    // New athlete invites (written by Coach Reef or the admin from the admin page).
    match /invites/{id} {
      allow read, write: if staff();
    }

    // Events and announcements. Approved members read; coach and admin post. Athletes tap I'm in (their own entry only).
    match /posts/{id} {
      allow read: if staff() || approved();
      allow write: if staff();
      match /going/{uid} {
        allow read: if staff() || approved();
        allow write: if staff() || (isMe(uid) && (approved() || isCoach())
          && (request.resource == null || request.resource.data.keys().hasOnly(['name', 'at', 'heat', 'team', 'partner', 'gym'])));
      }
    }
    match /{path=**}/going/{uid} {
      allow read: if staff() || approved();
    }

    // SugarWOD card notes. Athlete notes: approved members read. Coaches notes: coaches only.
    match /cardnotes/{d} {
      allow read: if isCoach() || approved();
      allow write: if isCoach();
    }
    match /coachnotes/{d} {
      allow read, write: if isCoach();
    }
    // Coaches who run one class read only that program's coaches notes (members/{uid}.staffProgs, set by Reef).
    match /staffnotes/{prog}/days/{d} {
      allow read: if isCoach() || (approved()
        && prog in get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('staffProgs', []));
      allow write: if isCoach();
    }
  }
}
