rules_version = '2';
// BODYBOX app (Firebase project teambodybox-app).
// Paste into Firebase console > Firestore > Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isCoach() {
      return signedIn()
        && request.auth.token.email in ['reefwtraining@gmail.com', 'reefwtraining+bodybox@gmail.com']
        && request.auth.token.email_verified == true;
    }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function approved() {
      return signedIn()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.approved == true;
    }

    // One doc per person who signs up. Only a coach can approve or turn programs on.
    // Members may only set their name and their picks/codes.
    match /members/{uid} {
      allow read: if isCoach() || isMe(uid);
      allow create: if isMe(uid)
        && request.resource.data.approved == false
        && request.resource.data.keys().hasOnly(['name', 'email', 'approved', 'created']);
      allow update: if isCoach()
        || (isMe(uid) && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'wants', 'codes', 'codeProgs', 'wantsAt', 'repick']));
      allow delete: if isCoach();
    }

    // Programming and leaderboard. Approved members read, coaches write.
    match /content/{docId} {
      allow read: if isCoach() || approved();
      allow write: if isCoach();
    }

    // People list for challenges (name only). Each person writes their own entry.
    match /people/{uid} {
      allow read: if isCoach() || approved();
      allow write: if isMe(uid) && (isCoach() || approved())
        && request.resource.data.keys().hasOnly(['name', 'a', 'at']);
    }

    // Head-to-head challenges. Only the two people in it can change it.
    match /challenges/{id} {
      allow read: if isCoach() || (signedIn() && request.auth.uid in resource.data.parts);
      allow create: if (isCoach() || approved())
        && request.resource.data.from.uid == request.auth.uid
        && request.auth.uid in request.resource.data.parts
        && request.resource.data.parts.size() == 2;
      allow update: if isCoach() || (signedIn() && request.auth.uid in resource.data.parts
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'scores', 'doneAt', 'at']));
      allow delete: if isCoach() || (signedIn() && resource.data.from.uid == request.auth.uid);
    }

    // Good job taps. Everyone sees them; you can only add or remove your own.
    match /cheers/{id} {
      allow read: if isCoach() || approved();
      allow create: if (isCoach() || approved()) && request.resource.data.uid == request.auth.uid
        && id.matches('.*__' + request.auth.uid);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Each person's own logs, scores, profile. Coaches (Reef + Claude's coach login) can read and enter data for anyone.
    match /data/users/{uid}/{docId} {
      allow read, write: if isMe(uid) && (approved() || isCoach());
      allow read, write: if isCoach();
    }
  }
}
